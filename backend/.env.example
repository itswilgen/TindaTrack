PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tindatrack_db
DB_CONNECTION_LIMIT=10
DB_SSL=false

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=tindatrack-api
JWT_AUDIENCE=tindatrack-app
SESSION_COOKIE_DAYS=7

# Set this to the exact number of trusted reverse proxies in production.
# Keep 0 when the API is accessed directly during local development.
TRUST_PROXY_HOPS=0

# Rate limits. These defaults support normal dashboard/POS usage while
# protecting login, write, export, payment, and lookup endpoints from bursts.
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_FAILURES=10
RATE_LIMIT_LOOKUPS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=60
RATE_LIMIT_SALES_PER_MINUTE=30
RATE_LIMIT_EXPORTS_PER_WINDOW=10
RATE_LIMIT_PAYMENTS_PER_WINDOW=20
RATE_LIMIT_WEBHOOKS_PER_MINUTE=120

GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Use console only for local development. Twilio Verify is required in production.
SMS_OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Use "paymongo" for real/test PayMongo API calls.
# Use "mock" only for local UI flow testing without PayMongo.
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=replace-with-paymongo-webhook-secret
PAYMONGO_HOSTED_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMONGO_MAYA_PAYMENT_METHOD_TYPES=card
